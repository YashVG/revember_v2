{
  "name": "revember-mcp-server",
  "version": "0.1.0",
  "description": "Local MCP server for the Revember v2 knowledge base.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashVG/revember_v2.git"
  },
  "bugs": {
    "url": "https://github.com/YashVG/revember_v2/issues"
  },
  "type": "module",
  "bin": {
    "revember-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "remote": "node dist/remote.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx tests/run-tests.ts",
    "test:transport": "node tests/stdio-smoke.mjs",
    "test:http": "node --import tsx --test tests/http.test.ts",
    "test:bridge": "node --test tests/remote-bridge.test.mjs",
    "test:remote": "node tests/remote-smoke.mjs",
    "check": "npm run build && npm run test && npm run test:transport && npm run test:http && npm run test:bridge"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.6",
    "qs": "6.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
