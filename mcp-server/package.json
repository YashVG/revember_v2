{
  "name": "revember-mcp-server",
  "version": "0.1.0",
  "description": "Local MCP server for the Revember v2 knowledge base.",
  "type": "module",
  "bin": {
    "revember-mcp-server": "./dist/index.js"
  },
  "scripts": {
